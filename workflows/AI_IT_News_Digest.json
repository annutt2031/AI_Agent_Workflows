    {
      "parameters": {
        "jsCode": "const posts = $json.posts || [];\n\nconst cleanHtml = (s) => (s || '').toString().replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst normalized = posts.map((p) => ({\n  channel: p.channel || p.channelTitle || 'Unknown channel',\n  title: cleanHtml(p.title),\n  link: p.link || '',\n  text: cleanHtml(p.snippet || p.content || ''),\n  pubDate: p.pubDate || p.isoDate || '',\n}));\n\nreturn [\n  {\n    json: {\n      posts: normalized,\n      postsText: JSON.stringify(normalized, null, 2), // вот это будем скармливать AI Agent\n      postsTotal: normalized.length,\n      channelsCount: [...new Set(normalized.map(p => p.channel))].length,\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
